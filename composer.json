{
	"name": "yard/acf-registrar",
	"type": "package",
	"description": "PHP package to register ACF Field Groups, Forms and Option Pages",
	"license": "MIT",
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true
		},
		"platform": {
			"php": "8.2"
		}
	},
	"require": {
		"php": ">=8.2",
		"vinkla/extended-acf": "^13.8"
	},
	"require-dev": {
		"10up/wp_mock": "^0.4.2",
		"pestphp/pest": "^2.36",
		"php-stubs/acf-pro-stubs": "^6.3",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"yard/php-cs-fixer-rules": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"Yard\\Acf\\Registrar\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Yard\\Acf\\Registrar\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"all": [
			"@test",
			"@analyse",
			"@format"
		],
		"analyse": "vendor/bin/phpstan analyse --debug --memory-limit 1G",
		"format": "vendor/bin/php-cs-fixer fix",
		"test": "vendor/bin/pest",
		"test:coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage"
	}
}
